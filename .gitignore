# secrets
.env

# pixi
.pixi/

# data — regenerable from the pipeline, and the DEM tiles are large
data/raw/**
data/interim/**
data/processed/**
!data/**/.gitkeep

# generated outputs (keep the small ones tracked via -f if desired)
outputs/*.tif
outputs/*.gpkg
# regenerated by `pixi run pipeline`; 1.3 MB of aerial-imagery panels
outputs/connector_review.png

# georeferencing sources for the printed trail map. The warped sheet is hosted on
# MapWarper (mapwarper.net/maps/110238) and the site pulls tiles from there, so ~65 MB
# of scans would sit in every clone without a single line of code ever reading them.
*.pdf
*.tif

# QGIS projects — they store absolute local paths, so they do not open for anyone else
*.qgz
# GDAL writes a sidecar next to any raster it opens, including the map PDF above.
*.aux.xml

# http cache written by py3dep / pynhd
cache/

# python
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/

# marimo session snapshots — regenerated on every run
__marimo__/
notebooks/__marimo__/
